+/* ==========================================================
+   TYRETRACK ADMIN — GLOBAL RESPONSIVE LAYER
+   Loaded once (via AdminLayout) for every admin page.
+   Breakpoints:
+     >=1024px  Desktop / Laptop  — persistent sidebar
+     769-1023  Tablet            — drawer sidebar, 2-col grids
+     481-768   Large mobile      — drawer sidebar, 1-col
+     <=480     Small mobile      — compact spacing/type
+   This file only tightens/guards existing component CSS —
+   it never overrides colors, gradients, or component logic.
+   ========================================================== */
+
+/* Prevent any admin element from ever forcing horizontal
+   scroll on the page itself; individual wide elements (tables)
+   get their own scroll container instead. */
+.admin-content,
+.admin-content * {
+  box-sizing: border-box;
+}
+
+.admin-content img,
+.admin-content svg {
+  max-width: 100%;
+  height: auto;
+}
+
+/* ==========================================================
+   TABLES — always horizontally scrollable on their own,
+   never squeeze columns or blow out the page width.
+   ========================================================== */
+
+.quotes-table {
+  overflow-x: auto;
+  overflow-y: hidden;
+  -webkit-overflow-scrolling: touch;
+}
+
+.quotes-table table {
+  min-width: 720px;
+}
+
+.invoice-preview {
+  overflow-x: auto;
+  -webkit-overflow-scrolling: touch;
+}
+
+.invoice-table {
+  min-width: 360px;
+}
+
+/* ==========================================================
+   DEFENSIVE FLEX WRAPPING
+   Rows built with justify-content:space-between should wrap
+   instead of crushing their contents on narrow viewports.
+   ========================================================== */
+
+.admin-header,
+.quotes-header,
+.invoice-header,
+.history-header,
+.history-banner,
+.history-highlight-card,
+.invoice-mode {
+  flex-wrap: wrap;
+  row-gap: 14px;
+}
+
+/* ==========================================================
+   TABLET (<=1023px)
+   ========================================================== */
+
+@media (max-width: 1023px) {
+  .quote-stats {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .profile-stats {
+    grid-template-columns: repeat(3, 1fr);
+    gap: 12px;
+  }
+}
+
+/* ==========================================================
+   LARGE MOBILE (<=768px)
+   ========================================================== */
+
+@media (max-width: 768px) {
+  .admin-page {
+    padding: 100px 16px 60px;
+  }
+
+  .admin-quotes {
+    padding: 20px 16px;
+  }
+
+  .admin-header,
+  .quotes-header {
+    text-align: center;
+    justify-content: center;
+  }
+
+  .admin-controls {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .admin-search,
+  .admin-filter,
+  .filter-select {
+    width: 100%;
+    min-width: 0;
+  }
+
+  .admin-nav {
+    justify-content: center;
+  }
+
+  .admin-nav button {
+    flex: 1 1 140px;
+  }
+
+  .history-banner,
+  .history-highlight-card,
+  .profile-top {
+    text-align: left;
+  }
+
+  .invoice-preview {
+    padding: 22px;
+  }
+
+  .invoice-header {
+    justify-content: center;
+    text-align: center;
+  }
+}
+
+/* ==========================================================
+   SMALL MOBILE (<=480px)
+   ========================================================== */
+
+@media (max-width: 480px) {
+  .admin-container h1,
+  .admin-page h1 {
+    font-size: 1.7rem;
+  }
+
+  .quotes-header h1 {
+    font-size: 1.5rem;
+  }
+
+  .admin-card,
+  .stat-card,
+  .quote-stat-card {
+    padding: 18px;
+  }
+
+  .admin-login-card {
+    padding: 30px 24px;
+  }
+
+  .admin-logo {
+    padding: 60px 18px 24px;
+  }
+
+  .profile-stats {
+    grid-template-columns: repeat(3, 1fr);
+    font-size: 16px;
+    gap: 8px;
+  }
+
+  .invoice-preview {
+    padding: 16px;
+  }
+}
+
+/* ==========================================================
+   VERY SMALL MOBILE (<=360px)
+   ========================================================== */
+
+@media (max-width: 360px) {
+  .admin-container h1,
+  .admin-page h1 {
+    font-size: 1.45rem;
+  }
+
+  .admin-nav button {
+    flex: 1 1 100%;
+  }
+}
